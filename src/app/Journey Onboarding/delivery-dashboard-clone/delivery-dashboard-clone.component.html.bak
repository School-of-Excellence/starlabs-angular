<div class="loading-overlay" *ngIf="isLoading">
  <div class="loading-container">
    <div class="loading-spinner"></div>
    <div class="loading-text">{{ 'Loading Dashboard..' }}</div>
    <div class="loading-progress">
      <div class="progress-bar">
        <div class="progress-fill" [style.width.%]="getLoadingProgress()"></div>
      </div>
    </div>
  </div>
</div>

<div class="dashboard-container">
<div class="dd-app">

  <!-- HEADER (ported from design.html) ===================== -->
  <header class="dd-header">
    <div class="dd-header__title-block">
      <span class="dd-eyebrow">Delivery Ops</span>
      <h1 class="dd-title">Delivery Dashboard</h1>
      <div class="dd-meta-line" role="status" aria-live="polite">
        <span class="dd-meta-pulse" aria-label="Data is live"></span>
        <span>Live &middot; refreshed <span class="dd-meta-num">{{ lastUpdatedRelative }}</span></span>
        <span class="dd-meta-sep" aria-hidden="true">&middot;</span>
        <span><span class="dd-meta-num">{{ visibleCardIds.length }}</span> products tracked</span>
        <ng-container *ngIf="hiddenCardIds.length > 0">
          <span class="dd-meta-sep" aria-hidden="true">&middot;</span>
          <span><span class="dd-meta-num">{{ hiddenCardIds.length }}</span> hidden</span>
        </ng-container>
      </div>
    </div>
    <div class="dd-filter-bar">
      <button class="dd-btn dd-btn--ghost" [class.dd-btn--active]="selectedTimeFilter === 'all'"
        (click)="onFilterClick('all')">All time</button>
      <button class="dd-btn" (click)="picker.open()">
        <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12"><rect x="2.5" y="3.5" width="11" height="10" rx="1.5"/><path d="M11 2v3M5 2v3M2.5 7h11" stroke-linecap="round"/></svg>
        Date Range
        <mat-form-field appearance="outline" class="date-range-field-hidden">
          <mat-date-range-input [formGroup]="range" [rangePicker]="picker">
            <input matStartDate formControlName="start" placeholder="Start date">
            <input matEndDate formControlName="end" placeholder="End date">
          </mat-date-range-input>
          <mat-date-range-picker #picker></mat-date-range-picker>
        </mat-form-field>
      </button>
      <button class="dd-btn" [class.dd-btn--active]="selectedTimeFilter === '30days'"
        (click)="onFilterClick('30days')">Last 30 days</button>
      <button class="dd-btn" [class.dd-btn--active]="selectedTimeFilter === 'thismonth'"
        (click)="onFilterClick('thismonth')">This month</button>

      <span class="dd-fdiv"></span>

      <button class="dd-pfilter" type="button">
        <span class="dd-pfilter__ico" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="13" height="13"><path d="M2 4h12M4 8h8M6 12h4" stroke-linecap="round"/></svg>
        </span>
        <span class="dd-pfilter__body">
          <span class="dd-pfilter__lbl">Products</span>
          <span class="dd-pfilter__val">{{ allProductsSelected ? ('All ' + visibleCardIds.length) : (productSelectTrigger || ('All ' + visibleCardIds.length)) }}<span class="dd-pfilter__hint" *ngIf="hiddenCardIds.length > 0"> &middot; {{ hiddenCardIds.length }} hidden</span></span>
        </span>
        <svg class="dd-pfilter__chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12"><path d="M4 6l4 4 4-4" stroke-linecap="round"/></svg>
        <mat-form-field appearance="outline" class="product-select-field" subscriptSizing="dynamic">
          <mat-label>Products</mat-label>
          <mat-select multiple [formControl]="productFilterControl" panelClass="product-panel" placeholder="All products">
            <mat-select-trigger>{{ productSelectTrigger }}</mat-select-trigger>
            <mat-option *ngFor="let p of availableCardLabels" [value]="p">{{ p }}</mat-option>
          </mat-select>
        </mat-form-field>
      </button>
    </div>
  </header>

  <!-- KPI BENTO (ported) =================================== -->
  <section class="dd-kpi">
    <div class="dd-hero">
      <div class="dd-hero__head">
        <span class="dd-hero__eyebrow">Active Pipeline</span>
        <span class="dd-live"><span class="dd-live__dot"></span>Live</span>
      </div>
      <div class="dd-hero__row">
        <span class="dd-hero__num">{{ kpiOngoingTotal | number }}</span>
        <div class="dd-hero__meta">
          <span class="dd-hero__delta-lbl">ongoing now</span>
        </div>
      </div>
      <span class="dd-hero__sub">participants currently in motion across {{ visibleCardIds.length }} visible products</span>
      <div class="dd-hero__funnel">
        <div class="dd-khf" *ngFor="let cardId of visibleCardIds">
          <span class="dd-khf__name">{{ getCardName(cardId) }}</span>
          <div class="dd-khf__bar"><div class="dd-khf__fill" [style.width.%]="ongoingPctOfMax(cardId)"></div></div>
          <span class="dd-khf__num">{{ ongoingByCard(cardId) }}</span>
        </div>
      </div>
    </div>

    <div class="dd-kpi-grid">
      <div class="dd-kcell dd-kcell--ready" [class.dd-kcell--empty]="kpiReadyToInitiate === 0"
        (click)="navToAttention('ready')">
        <span class="dd-kcell__label">Ready to Initiate</span>
        <span class="dd-kcell__value">{{ kpiReadyToInitiate | number }}</span>
        <span class="dd-kcell__delta">cleared, awaiting action</span>
        <div class="dd-kcell__spark">
          <div class="b" *ngFor="let v of sparkReady"
            [style.height.%]="(v / sparkMax(sparkReady)) * 100"
            [class.empty]="v === 0"></div>
        </div>
      </div>

      <div class="dd-kcell dd-kcell--stuck" [class.dd-kcell--alert]="kpiStuck > 0"
        [class.dd-kcell--empty]="kpiStuck === 0"
        (click)="navToAttention('stuck')">
        <span class="dd-kcell__label">Stuck Cases</span>
        <span class="dd-kcell__value">{{ kpiStuck | number }}</span>
        <span class="dd-kcell__delta">need intervention</span>
        <div class="dd-kcell__spark">
          <div class="b" *ngFor="let v of sparkStuck"
            [style.height.%]="(v / sparkMax(sparkStuck)) * 100"
            [class.empty]="v === 0"></div>
        </div>
      </div>

      <div class="dd-kcell dd-kcell--done">
        <span class="dd-kcell__label">Completed</span>
        <span class="dd-kcell__value">{{ kpiCompletedTotal | number }}</span>
        <span class="dd-kcell__delta">in selected range</span>
        <div class="dd-kcell__spark">
          <div class="b" *ngFor="let v of sparkCompleted"
            [style.height.%]="(v / sparkMax(sparkCompleted)) * 100"
            [class.empty]="v === 0"></div>
        </div>
      </div>

      <div class="dd-kcell dd-kcell--avg">
        <span class="dd-kcell__label">Avg Time</span>
        <span class="dd-kcell__value">{{ kpiAvgComplete }}<span class="dd-kcell__unit">d</span></span>
        <div class="dd-kcell__gauge">
          <div class="dd-gauge-track">
            <div class="dd-gauge-fill" [style.width.%]="avgTimePct"></div>
            <div class="dd-gauge-target" [style.left.%]="100"></div>
          </div>
          <span class="dd-gauge-lbl">target {{ avgTimeTarget }}d</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ACTION CENTER (ported) =============================== -->
  <section class="dd-action">
    <div>
      <div class="dd-section-head">
        <span class="dd-section-title">Needs your attention</span>
        <span class="dd-section-sub">act on these first</span>
      </div>
      <div class="dd-attention">
        <button class="dd-tile dd-tile--alert" [class.dd-tile--empty]="kpiStuck === 0"
          (click)="navToAttention('stuck')">
          <span class="dd-tile__num">{{ kpiStuck | number }}</span>
          <span class="dd-tile__label">Stuck</span>
          <span class="dd-tile__hint">14+ days no movement</span>
          <span class="dd-tile__arr">&rarr;</span>
        </button>
        <button class="dd-tile" [class.dd-tile--empty]="kpiAwaitingTotal === 0"
          (click)="navToAttention('awaiting')">
          <span class="dd-tile__num">{{ kpiAwaitingTotal | number }}</span>
          <span class="dd-tile__label">Awaiting Initiation</span>
          <span class="dd-tile__hint">payment status pending</span>
          <span class="dd-tile__arr">&rarr;</span>
        </button>
        <button class="dd-tile dd-tile--ok" [class.dd-tile--empty]="kpiReadyToInitiate === 0"
          (click)="navToAttention('ready')">
          <span class="dd-tile__num">{{ kpiReadyToInitiate | number }}</span>
          <span class="dd-tile__label">Ready</span>
          <span class="dd-tile__hint">cleared, initiate now</span>
          <span class="dd-tile__arr">&rarr;</span>
        </button>
        <button class="dd-tile" [class.dd-tile--empty]="kpiInitiatedNotConsuming === 0"
          (click)="navToAttention('idle')">
          <span class="dd-tile__num">{{ kpiInitiatedNotConsuming | number }}</span>
          <span class="dd-tile__label">Started, not consuming</span>
          <span class="dd-tile__hint">initiated but inactive</span>
          <span class="dd-tile__arr">&rarr;</span>
        </button>
      </div>
    </div>

    <div>
      <div class="dd-section-head">
        <span class="dd-section-title">Pipeline by product</span>
        <span class="dd-section-sub">funnel shape</span>
      </div>
      <div class="dd-pby">
        <div class="dd-pby-legend">
          <span class="dd-pby-legend__item"><span class="dd-pby-legend__sw dd-bg-s1"></span>Init</span>
          <span class="dd-pby-legend__item"><span class="dd-pby-legend__sw dd-bg-s2"></span>Await</span>
          <span class="dd-pby-legend__item"><span class="dd-pby-legend__sw dd-bg-s3"></span>Started</span>
          <span class="dd-pby-legend__item"><span class="dd-pby-legend__sw dd-bg-s4"></span>Ongoing</span>
          <span class="dd-pby-legend__item"><span class="dd-pby-legend__sw dd-bg-s5"></span>Done</span>
        </div>
        <ng-container *ngFor="let cardId of visibleCardIds">
          <ng-container *ngIf="getCardFunnel(cardId) as f">
            <div class="dd-pby-row">
              <span class="dd-pby-row__name" [title]="getCardName(cardId)">{{ getCardName(cardId) }}</span>
              <div class="dd-pby-row__bar">
                <div class="dd-pby-row__seg dd-bg-s1" *ngIf="f.initiated.length > 0" [style.flex]="f.initiated.length"></div>
                <div class="dd-pby-row__seg dd-bg-s2" *ngIf="f.awaiting.length > 0"  [style.flex]="f.awaiting.length"></div>
                <div class="dd-pby-row__seg dd-bg-s3" *ngIf="f.started.length > 0"   [style.flex]="f.started.length"></div>
                <div class="dd-pby-row__seg dd-bg-s4" *ngIf="(f.ongoing?.length || 0) > 0" [style.flex]="f.ongoing?.length || 0"></div>
                <div class="dd-pby-row__seg dd-bg-s5" *ngIf="f.completed.length > 0" [style.flex]="f.completed.length"></div>
              </div>
              <span class="dd-pby-row__total">{{ getCardPipelineTotal(cardId) | number }}</span>
            </div>
          </ng-container>
        </ng-container>
      </div>
    </div>
  </section>

  <!-- TAB STRIP (custom, drives outerTabIndex) ============= -->
  <div class="dd-tabs">
    <button class="dd-tab" [class.is-active]="outerTabIndex === 0" (click)="outerTabIndex = 0">
      Overview <span class="dd-tab__count">{{ visibleCardIds.length }}</span>
    </button>
    <button class="dd-tab" [class.is-active]="outerTabIndex === 1" (click)="outerTabIndex = 1">Analytics</button>
    <button class="dd-tab" [class.is-active]="outerTabIndex === 2" (click)="outerTabIndex = 2">
      Participants <span class="dd-tab__count">{{ participantsTotalCount | number }}</span>
    </button>
  </div>

  <ng-container *ngIf="hiddenCardIds.length > 0">
            <span class="dashboard-meta-sep" aria-hidden="true">&middot;</span>
            <span class="dashboard-meta-text"><span class="dashboard-meta-num">{{ hiddenCardIds.length }}</span> hidden</span>
          </ng-container>
        </div>
      </div>
    </div>
  </header>

  <!-- ========== FILTER STRIP (offset below header) ========== -->
  <section class="filter-strip">
    <div class="filter-strip-left">
      <button class="filter-allbtn" [class.active]="selectedTimeFilter === 'all'"
        (click)="onFilterClick(selectedTimeFilter === 'all' ? 'thismonth' : 'all')">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" *ngIf="selectedTimeFilter === 'all'" />
        </svg>
        {{ selectedTimeFilter === 'all' ? 'Viewing all time' : 'Show all time' }}
      </button>
      <div class="date-input" (click)="picker.open()">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        Date Range
        <mat-form-field appearance="outline" class="date-range-field-hidden">
          <mat-date-range-input [formGroup]="range" [rangePicker]="picker">
            <input matStartDate formControlName="start" placeholder="Start date">
            <input matEndDate formControlName="end" placeholder="End date">
          </mat-date-range-input>
          <mat-date-range-picker #picker></mat-date-range-picker>
        </mat-form-field>
      </div>
      <div class="filter-summary-chip" *ngIf="activeFilterSummary">
        <span class="filter-summary-dot"></span>
        <span class="filter-summary-text">{{ activeFilterSummary }}</span>
      </div>
    </div>
    <div class="filter-strip-right">
      <mat-form-field appearance="outline" class="product-select-field" subscriptSizing="dynamic">
        <mat-label>Products</mat-label>
        <mat-select multiple [formControl]="productFilterControl" panelClass="product-panel" placeholder="All products">
          <mat-select-trigger>{{ productSelectTrigger }}</mat-select-trigger>
          <mat-option *ngFor="let p of availableCardLabels" [value]="p">{{ p }}</mat-option>
        </mat-select>
      </mat-form-field>
      <mat-slide-toggle
        [checked]="allProductsSelected"
        (change)="toggleAllProducts($event.checked)"
        class="product-all-toggle"
        color="primary">
        All
      </mat-slide-toggle>
    </div>
  </section>

  <!-- ========== KPI BENTO (Mission Control) ========== -->
  <section class="kpi-bento">
    <div class="kpi-hero">
      <div class="kpi-hero-head">
        <span class="kpi-hero-eyebrow">ACTIVE PIPELINE</span>
        <span class="kpi-hero-badge"><span class="kpi-hero-badge-dot"></span>LIVE</span>
      </div>
      <div class="kpi-hero-stats">
        <div class="khs-block">
          <span class="khs-num">{{ kpiActivePipeline | number }}</span>
          <span class="khs-lbl">Eligible</span>
        </div>
        <div class="khs-divider"></div>
        <div class="khs-block">
          <span class="khs-num">{{ kpiOngoingTotal | number }}</span>
          <span class="khs-lbl">Ongoing</span>
        </div>
      </div>
      <div class="kpi-hero-sub">across {{ visibleCardIds.length }} products</div>
      <div class="kpi-hero-funnel">
        <div class="khf-row" *ngFor="let cardId of visibleCardIds.slice(0, 4)">
          <span class="khf-name">{{ getCardName(cardId) }}</span>
          <div class="khf-track">
            <div class="khf-fill" [style.width.%]="(getCardGroupedFiltered(cardId).length / (kpiActivePipeline || 1)) * 100"></div>
            <div class="khf-fill khf-fill-ongoing" [style.width.%]="(getCardOngoing(cardId) / (kpiActivePipeline || 1)) * 100"></div>
          </div>
          <span class="khf-num">
            {{ getCardGroupedFiltered(cardId).length | number }}<span class="khf-num-sep"> · </span><span class="khf-num-ongoing">{{ getCardOngoing(cardId) | number }}</span>
          </span>
        </div>
      </div>
      <div class="kpi-hero-glyph" aria-hidden="true">
        <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
          <circle cx="60" cy="60" r="48" stroke="currentColor" stroke-width="1" opacity="0.15"/>
          <circle cx="60" cy="60" r="32" stroke="currentColor" stroke-width="1" opacity="0.2"/>
          <circle cx="60" cy="60" r="16" stroke="currentColor" stroke-width="1" opacity="0.3"/>
          <circle cx="60" cy="60" r="3" fill="currentColor"/>
        </svg>
      </div>
    </div>
    <div class="kpi-grid">
      <div class="kpi-cell kpi-ready" [class.kpi-empty]="kpiReadyToInitiate === 0">
        <div class="kpi-row">
          <div class="kpi-stack">
            <span class="kpi-label">Ready to Initiate</span>
            <span class="kpi-value">{{ kpiReadyToInitiate | number }}</span>
            <span class="kpi-hint">cleared, awaiting action</span>
          </div>
          <div class="kpi-spark">
            <div class="kpi-spark-bar" *ngFor="let v of sparkReady"
              [style.height.%]="(v / sparkMax(sparkReady)) * 100"
              [class.empty]="v === 0"></div>
          </div>
        </div>
      </div>
      <div class="kpi-cell kpi-stuck" [class.kpi-empty]="kpiStuck === 0" [class.kpi-alert]="kpiStuck > 0">
        <div class="kpi-row">
          <div class="kpi-stack">
            <span class="kpi-label">Stuck Cases</span>
            <span class="kpi-value">{{ kpiStuck | number }}</span>
            <span class="kpi-hint">need intervention</span>
          </div>
          <div class="kpi-spark kpi-spark-rose">
            <div class="kpi-spark-bar" *ngFor="let v of sparkStuck"
              [style.height.%]="(v / sparkMax(sparkStuck)) * 100"
              [class.empty]="v === 0"></div>
          </div>
        </div>
      </div>
      <div class="kpi-cell kpi-completed">
        <div class="kpi-row">
          <div class="kpi-stack">
            <span class="kpi-label">Completed</span>
            <span class="kpi-value">{{ kpiCompletedTotal | number }}</span>
            <span class="kpi-hint">in selected range</span>
          </div>
          <div class="kpi-spark kpi-spark-violet">
            <div class="kpi-spark-bar" *ngFor="let v of sparkCompleted"
              [style.height.%]="(v / sparkMax(sparkCompleted)) * 100"
              [class.empty]="v === 0"></div>
          </div>
        </div>
      </div>
      <div class="kpi-cell kpi-avg">
        <div class="kpi-stack kpi-stack-avg">
          <span class="kpi-label">Avg. Time</span>
          <span class="kpi-value">{{ kpiAvgComplete }}<span class="kpi-unit">d</span></span>
          <div class="kpi-gauge">
            <div class="kpi-gauge-track">
              <div class="kpi-gauge-fill" [style.width.%]="avgTimePct"
                [class.over]="kpiAvgComplete > avgTimeTarget"></div>
              <div class="kpi-gauge-target" [style.left.%]="100 * avgTimeTarget / Math.max(kpiAvgComplete, avgTimeTarget, 30) || 50"></div>
            </div>
            <span class="kpi-gauge-label">target {{ avgTimeTarget }}d</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== STATUS FOOTER (ops silhouette) ========== -->
  <section class="status-footer" *ngIf="false">
  </section>

  <!-- ========== ACTION CENTER (Option A) ========== -->
  <section class="action-center">
    <div class="ac-card ac-attention">
      <div class="ac-card-head">
        <span class="ac-card-title">Needs your attention</span>
        <span class="ac-card-sub">act on these first</span>
      </div>
      <div class="ac-attention-grid">
        <button class="ac-tile ac-tile-stuck" [class.ac-tile-empty]="kpiStuck === 0"
          (click)="navToAttention('stuck')"
          [attr.aria-label]="kpiStuck + ' stuck cases. Open Participants tab.'">
          <span class="ac-tile-num">{{ kpiStuck | number }}</span>
          <span class="ac-tile-label">Stuck</span>
          <span class="ac-tile-hint">14+ days no movement</span>
          <span class="ac-tile-arrow" aria-hidden="true">&rarr;</span>
        </button>
        <button class="ac-tile ac-tile-awaiting" [class.ac-tile-empty]="kpiAwaitingTotal === 0"
          (click)="navToAttention('awaiting')"
          [attr.aria-label]="kpiAwaitingTotal + ' awaiting initiation. Open Participants tab.'">
          <span class="ac-tile-num">{{ kpiAwaitingTotal | number }}</span>
          <span class="ac-tile-label">Awaiting Initiation</span>
          <span class="ac-tile-hint">payment status pending</span>
          <span class="ac-tile-arrow" aria-hidden="true">&rarr;</span>
        </button>
        <button class="ac-tile ac-tile-ready" [class.ac-tile-empty]="kpiReadyToInitiate === 0"
          (click)="navToAttention('ready')"
          [attr.aria-label]="kpiReadyToInitiate + ' ready to initiate. Open Participants tab.'">
          <span class="ac-tile-num">{{ kpiReadyToInitiate | number }}</span>
          <span class="ac-tile-label">Ready</span>
          <span class="ac-tile-hint">cleared, initiate now</span>
          <span class="ac-tile-arrow" aria-hidden="true">&rarr;</span>
        </button>
        <button class="ac-tile ac-tile-notconsuming" [class.ac-tile-empty]="kpiInitiatedNotConsuming === 0"
          (click)="navToAttention('idle')"
          [attr.aria-label]="kpiInitiatedNotConsuming + ' started but inactive. Open Participants tab.'">
          <span class="ac-tile-num">{{ kpiInitiatedNotConsuming | number }}</span>
          <span class="ac-tile-label">Started, not consuming</span>
          <span class="ac-tile-hint">initiated but inactive</span>
          <span class="ac-tile-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>
    <div class="ac-card ac-pipeline-bar">
      <div class="ac-card-head">
        <span class="ac-card-title">Pipeline by product</span>
        <span class="ac-card-sub">funnel shape per product</span>
      </div>
      <div class="acp-legend">
        <span class="acp-legend-item"><span class="acp-dot acp-dot-init"></span>Init</span>
        <span class="acp-legend-item"><span class="acp-dot acp-dot-await"></span>Await</span>
        <span class="acp-legend-item"><span class="acp-dot acp-dot-started"></span>Started</span>
        <span class="acp-legend-item"><span class="acp-dot acp-dot-ongoing"></span>Ongoing</span>
        <span class="acp-legend-item"><span class="acp-dot acp-dot-done"></span>Done</span>
      </div>
      <div class="acp-rows">
        <ng-container *ngFor="let cardId of visibleCardIds; trackBy: trackByCardId">
          <ng-container *ngIf="getCardFunnel(cardId) as f">
            <div class="acp-row">
              <span class="acp-name" [title]="getCardName(cardId)">{{ getCardName(cardId) }}</span>
              <div class="acp-bar" *ngIf="getCardPipelineTotal(cardId) > 0; else acpEmpty">
                <div class="acp-seg acp-seg-init" *ngIf="f.initiated.length > 0" [style.flex]="f.initiated.length"
                  [title]="'Init: ' + f.initiated.length"></div>
                <div class="acp-seg acp-seg-await" *ngIf="f.awaiting.length > 0" [style.flex]="f.awaiting.length"
                  [title]="'Await: ' + f.awaiting.length"></div>
                <div class="acp-seg acp-seg-started" *ngIf="f.started.length > 0" [style.flex]="f.started.length"
                  [title]="'Started: ' + f.started.length"></div>
                <div class="acp-seg acp-seg-ongoing" *ngIf="(f.ongoing?.length || 0) > 0"
                  [style.flex]="f.ongoing?.length || 0" [title]="'Ongoing: ' + (f.ongoing?.length || 0)"></div>
                <div class="acp-seg acp-seg-done" *ngIf="f.completed.length > 0" [style.flex]="f.completed.length"
                  [title]="'Done: ' + f.completed.length"></div>
              </div>
              <ng-template #acpEmpty>
                <div class="acp-bar acp-bar-empty">no pipeline</div>
              </ng-template>
              <span class="acp-total">{{ getCardPipelineTotal(cardId) | number }}</span>
            </div>
          </ng-container>
        </ng-container>
        <div class="acp-empty-state" *ngIf="visibleCardIds.length === 0">No products in current filter.</div>
      </div>
    </div>
  </section>


  <mat-tab-group class="dd-tab-group" animationDuration="200ms" dynamicHeight
                 [(selectedIndex)]="outerTabIndex"
                 (selectedTabChange)="onOuterTabChange($event)">
    <mat-tab label="Overview">
      <ng-template matTabContent>
  <!-- ========== VISIBLE PRODUCT CARDS ========== -->
  <div class="grid">
    <div class="card" *ngFor="let cardId of visibleCardIds; trackBy: trackByCardId">
      <div class="card-top">
        <div class="card-title-block">
          <div class="card-title">{{ getCardName(cardId) }}</div>
          <div class="card-subtitle" *ngIf="getCardSubNames(cardId).length > 0">{{ getCardSubNames(cardId).join(' · ') }}</div>
        </div>
        <div class="card-hero clickable" (click)="openCardModal(cardId, 'filtered'); $event.stopPropagation()">
          <span class="card-hero-num" [class.zero]="getCardGroupedFiltered(cardId).length === 0">{{ getCardGroupedFiltered(cardId).length | number }}</span>
          <span class="card-hero-label">Eligible</span>
        </div>
      </div>

      <div class="chip-row">
        <button class="chip chip-overall clickable" (click)="openCardModal(cardId, 'all'); $event.stopPropagation()">
          <span class="chip-num">{{ getCardGroupedAll(cardId).length | number }}</span>
          <span class="chip-label">Overall</span>
        </button>
        <button class="chip chip-noteligible clickable" [class.chip-empty]="getCardGroupedNotEligible(cardId).length === 0"
          (click)="openCardModal(cardId, 'noteligible'); $event.stopPropagation()">
          <span class="chip-num">{{ getCardGroupedNotEligible(cardId).length | number }}</span>
          <span class="chip-label">Not Eligible</span>
        </button>
        <button class="chip chip-purchased clickable" [class.chip-empty]="getCardGroupedPurchased(cardId).length === 0"
          (click)="openCardModal(cardId, 'purchased'); $event.stopPropagation()">
          <span class="chip-num">{{ getCardGroupedPurchased(cardId).length | number }}</span>
          <span class="chip-label">Purchased</span>
        </button>
        <button class="chip chip-bonus clickable" [class.chip-empty]="getCardGroupedBonus(cardId).length === 0"
          (click)="openCardModal(cardId, 'bonus'); $event.stopPropagation()">
          <span class="chip-num">{{ getCardGroupedBonus(cardId).length | number }}</span>
          <span class="chip-label">Bonus</span>
        </button>
      </div>

      <div class="funnel-section">
        <div class="section-label">Journey Funnel</div>
        <div class="funnel-bars">
          <div class="funnel-bar funnel-bar-1 clickable" [class.funnel-bar-empty]="getCardFunnel(cardId).initiated.length === 0"
            (click)="openCardFunnelModal(cardId, 'initiated', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(cardId).initiated.length }}</span>
            <span class="funnel-bar-label">Init</span>
          </div>
          <div class="funnel-bar funnel-bar-2 clickable" [class.funnel-bar-empty]="getCardFunnel(cardId).awaiting.length === 0"
            (click)="openCardFunnelModal(cardId, 'awaiting', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(cardId).awaiting.length | number }}</span>
            <span class="funnel-bar-label">Await</span>
          </div>
          <div class="funnel-bar funnel-bar-3 clickable" [class.funnel-bar-empty]="getCardFunnel(cardId).started.length === 0"
            (click)="openCardFunnelModal(cardId, 'started', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(cardId).started.length }}</span>
            <span class="funnel-bar-label">Started</span>
          </div>
          <div class="funnel-bar funnel-bar-4 clickable" [class.funnel-bar-empty]="(getCardFunnel(cardId).ongoing?.length || 0) === 0"
            (click)="openCardFunnelModal(cardId, 'ongoing', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(cardId).ongoing?.length || 0 }}</span>
            <span class="funnel-bar-label">Ongoing</span>
          </div>
          <div class="funnel-bar funnel-bar-5 clickable funnel-bar-done"
            (click)="openCardFunnelModal(cardId, 'completed', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(cardId).completed.length }}</span>
            <span class="funnel-bar-label">Done</span>
          </div>
        </div>
      </div>

      <div class="card-footer">
        <div class="card-footer-left">
          <div class="time-stat clickable" (click)="openCardAvgModal(cardId, 'initToStart', $event)">
            <span class="time-stat-value" [class.zero]="getCardAvgInitToStart(cardId) === 0">{{ getCardAvgInitToStart(cardId) }}<span class="time-stat-unit">d</span></span>
            <span class="time-stat-label">Init &rarr; Start</span>
          </div>
          <div class="time-stat clickable" (click)="openCardAvgModal(cardId, 'startToComplete', $event)">
            <span class="time-stat-value" [class.zero]="getCardAvgStartToComplete(cardId) === 0">{{ getCardAvgStartToComplete(cardId) }}<span class="time-stat-unit">d</span></span>
            <span class="time-stat-label">Start &rarr; Done</span>
          </div>
        </div>
        <div class="card-footer-right">
          <button class="sub-pill sub-pill-ongoing sub-pill-clickable" type="button"
            (click)="openCardFunnelModal(cardId, 'ongoing', $event); $event.stopPropagation()"
            [attr.aria-label]="(getCardFunnel(cardId).ongoing?.length || 0) + ' ongoing participants in ' + getCardName(cardId)">
            <span class="sub-dot sub-dot-ongoing" aria-hidden="true"></span>{{ getCardFunnel(cardId).ongoing?.length || 0 }} ongoing
          </button>
          <span class="sub-pill"><span class="sub-dot sub-dot-inactive"></span>{{ getCardNonActiveSub(cardId) }} idle</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== HIDDEN PRODUCTS TOGGLE ========== -->
  <div class="show-more-row" *ngIf="hiddenCardIds.length > 0">
    <button class="show-more-btn" (click)="toggleHiddenProducts()">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <polyline *ngIf="!showHiddenProducts" points="6 9 12 15 18 9" />
        <polyline *ngIf="showHiddenProducts" points="18 15 12 9 6 15" />
      </svg>
      {{ showHiddenProducts ? 'Hide' : 'Show' }} {{ hiddenCardIds.length }} Hidden Products
    </button>
  </div>

  <!-- ========== HIDDEN PRODUCT CARDS ========== -->
  <div class="grid hidden-cards" *ngIf="showHiddenProducts">
    <div class="card hidden-card" *ngFor="let productId of hiddenCardIds; trackBy: trackByCardId">
      <div class="card-top">
        <div class="card-title-block">
          <div class="card-title">{{ mapProductName[productId] }}</div>
          <span class="hidden-tag">Hidden</span>
        </div>
        <div class="card-hero clickable" (click)="openCardModal(productId, 'filtered'); $event.stopPropagation()">
          <span class="card-hero-num" [class.zero]="getCardGroupedFiltered(productId).length === 0">{{ getCardGroupedFiltered(productId).length | number }}</span>
          <span class="card-hero-label">Eligible</span>
        </div>
      </div>

      <div class="chip-row">
        <button class="chip chip-overall clickable" (click)="openCardModal(productId, 'all'); $event.stopPropagation()">
          <span class="chip-num">{{ getCardGroupedAll(productId).length | number }}</span>
          <span class="chip-label">Overall</span>
        </button>
        <button class="chip chip-purchased clickable" [class.chip-empty]="getCardGroupedPurchased(productId).length === 0"
          (click)="openCardModal(productId, 'purchased'); $event.stopPropagation()">
          <span class="chip-num">{{ getCardGroupedPurchased(productId).length | number }}</span>
          <span class="chip-label">Purchased</span>
        </button>
        <button class="chip chip-bonus clickable" [class.chip-empty]="getCardGroupedBonus(productId).length === 0"
          (click)="openCardModal(productId, 'bonus'); $event.stopPropagation()">
          <span class="chip-num">{{ getCardGroupedBonus(productId).length | number }}</span>
          <span class="chip-label">Bonus</span>
        </button>
      </div>

      <div class="funnel-section">
        <div class="section-label">Journey Funnel</div>
        <div class="funnel-bars">
          <div class="funnel-bar funnel-bar-1 clickable" [class.funnel-bar-empty]="getCardFunnel(productId).initiated.length === 0"
            (click)="openCardFunnelModal(productId, 'initiated', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(productId).initiated.length }}</span>
            <span class="funnel-bar-label">Init</span>
          </div>
          <div class="funnel-bar funnel-bar-2 clickable" [class.funnel-bar-empty]="getCardFunnel(productId).awaiting.length === 0"
            (click)="openCardFunnelModal(productId, 'awaiting', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(productId).awaiting.length | number }}</span>
            <span class="funnel-bar-label">Await</span>
          </div>
          <div class="funnel-bar funnel-bar-3 clickable" [class.funnel-bar-empty]="getCardFunnel(productId).started.length === 0"
            (click)="openCardFunnelModal(productId, 'started', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(productId).started.length }}</span>
            <span class="funnel-bar-label">Started</span>
          </div>
          <div class="funnel-bar funnel-bar-4 clickable" [class.funnel-bar-empty]="(getCardFunnel(productId).ongoing?.length || 0) === 0"
            (click)="openCardFunnelModal(productId, 'ongoing', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(productId).ongoing?.length || 0 }}</span>
            <span class="funnel-bar-label">Ongoing</span>
          </div>
          <div class="funnel-bar funnel-bar-5 clickable funnel-bar-done"
            (click)="openCardFunnelModal(productId, 'completed', $event)">
            <span class="funnel-bar-num">{{ getCardFunnel(productId).completed.length }}</span>
            <span class="funnel-bar-label">Done</span>
          </div>
        </div>
      </div>

      <div class="card-footer">
        <div class="card-footer-left">
          <div class="time-stat clickable" (click)="openCardAvgModal(productId, 'initToStart', $event)">
            <span class="time-stat-value" [class.zero]="getCardAvgInitToStart(productId) === 0">{{ getCardAvgInitToStart(productId) }}<span class="time-stat-unit">d</span></span>
            <span class="time-stat-label">Init &rarr; Start</span>
          </div>
          <div class="time-stat clickable" (click)="openCardAvgModal(productId, 'startToComplete', $event)">
            <span class="time-stat-value" [class.zero]="getCardAvgStartToComplete(productId) === 0">{{ getCardAvgStartToComplete(productId) }}<span class="time-stat-unit">d</span></span>
            <span class="time-stat-label">Start &rarr; Done</span>
          </div>
        </div>
        <div class="card-footer-right">
          <span class="sub-pill sub-pill-ongoing"><span class="sub-dot sub-dot-ongoing"></span>{{ getCardFunnel(productId).ongoing?.length || 0 }} ongoing</span>
          <span class="sub-pill"><span class="sub-dot sub-dot-inactive"></span>{{ getCardNonActiveSub(productId) }} idle</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== PROFILE MODAL ========== -->
  <div class="modal-overlay" *ngIf="selectedProductId" (click)="closeModal()">
    <div class="modal-content" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <div class="modal-header-left">
          <h3>{{ getCardName(selectedProductId) }} -
            {{ modalType === 'all' ? 'All Eligible' :
            modalType === 'filtered' ? 'Filtered Eligible' :
            modalType === 'noteligible' ? 'Not Eligible' :
            modalType === 'bonus' ? 'Bonus' :
            modalType === 'purchased' ? 'Purchased' :
            modalType === 'thismonth' ? 'This Month' :
            modalType === 'nextmonth' ? 'Next Month' : '' }}
          </h3>
          <span class="modal-count">{{ profileIds.length }} profiles</span>
        </div>
        <div class="modal-header-right">
          <select *ngIf="modalType === 'purchased' || modalType === 'bonus'" class="custom-select pe-2"
            [(ngModel)]="selectedStatus" (change)="filterCardProfiles()">
            <option value="all">All</option>
            <option value="">Not Initiated</option>
            <option value="initiated">Initiated</option>
            <option value="ongoing">Ongoing</option>
            <option value="completed">Completed</option>
          </select>

          <button class="modal-export-btn pe-2" (click)="exportProfileModal()">Export</button>
          <button class="modal-close" (click)="closeModal()">✕</button>
        </div>
      </div>
      <div class="modal-body">
        <div class="profile-row" *ngFor="let pid of profileIds; let i = index">
          <div class="profile-header">
            <span class="participant-index">{{ i + 1 }}</span>
            <span class="participant-name">{{ mapMetaData[pid]?.['name'] || pid }}</span>
            <span class="product-count">{{ currentGroupedByProfile[pid]?.length }} products</span>
          </div>
          <div class="profile-products">
            <div class="product-tag" *ngFor="let item of currentGroupedByProfile[pid]">
              <span>{{ mapProductName[item['productref']?.id] || 'Unknown' }}</span>
              <span class="status-tag" [ngClass]="item['status']?.toLowerCase() || 'na'">{{ item['status'] || 'N/A'
                }}</span>
              <span *ngIf="!isParticipantEligible(pid, item)">
                <span>
                  <span class="fw-bold">Mode: </span>
                  <span>{{ mapMetaData[pid]?.['participantmode'] || pid }}</span>
                </span>
                <span class="ps-2"
                  *ngIf="(((item?.['minimumpayment'] || 0) - (mapMetaData[pid]?.['pp_totalpaid'] || 0))) >= 0">
                  <span class="fw-bold">Remaining Payable: </span>
                  <span>{{ formatPrice(((item?.['minimumpayment'] || 0) - (mapMetaData[pid]?.['pp_totalpaid'] || 0)))
                    }}</span>
                </span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== FUNNEL MODAL ========== -->
  <div class="modal-overlay" *ngIf="funnelModalOpen" (click)="closeFunnelModal()">
    <div class="modal-content" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <h3>{{ getCardName(funnelModalProductId!) }} — {{ funnelModalType | titlecase }}</h3>
        <span class="modal-count">{{ funnelProfileIds.length }} profiles</span>
        <button class="modal-export-btn" (click)="exportFunnelModal()">Export</button>
        <button class="modal-close" (click)="closeFunnelModal()">✕</button>
      </div>
      <div class="modal-body">
        <table class="avg-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Participant</th>
              <th>Product</th>
              <th>Initiated</th>
              <th>Ongoing</th>
              <th>Completed</th>
            </tr>
          </thead>
          <tbody>
            <ng-container *ngFor="let pid of funnelProfileIds; let i = index">
              <tr *ngFor="let item of funnelModalProfiles[pid]; let j = index">
                <td>{{ j === 0 ? (i + 1) : '' }}</td>
                <td>{{ j === 0 ? (mapMetaData[pid]?.['name'] || pid) : '' }}</td>
                <td>{{ mapProductName[item['productref']?.id] || 'Unknown' }}</td>
                <td>{{ item['statusdate']?.['initiated'] ? (getDateFromFieldPublic(item['statusdate']['initiated']) |
                  date:'dd MMM yyyy') : '-' }}</td>
                <td>{{ item['statusdate']?.['ongoing'] ? (getDateFromFieldPublic(item['statusdate']['ongoing']) |
                  date:'dd MMM yyyy') : '-' }}</td>
                <td>{{ item['statusdate']?.['completed'] ? (getDateFromFieldPublic(item['statusdate']['completed']) |
                  date:'dd MMM yyyy') : '-' }}</td>
              </tr>
            </ng-container>
          </tbody>
        </table>
        <div class="no-data" *ngIf="funnelProfileIds.length === 0">No participants in this stage.</div>
      </div>
    </div>
  </div>

  <!-- ========== AVG CALCULATION MODAL ========== -->
  <div class="modal-overlay" *ngIf="avgModalOpen" (click)="closeAvgModal()">
    <div class="modal-content avg-modal" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <h3>
          {{ getCardName(avgModalProductId!) }} —
          {{ avgModalType === 'initToStart' ? 'Initiation → Start' : 'Start → Complete' }}
        </h3>
        <button class="modal-close" (click)="closeAvgModal()">✕</button>
      </div>
      <div class="avg-summary">
        <div class="avg-summary-item"><span class="avg-summary-value">{{ avgModalDetails.length }}</span><span
            class="avg-summary-label">Participants</span></div>
        <div class="avg-summary-item"><span class="avg-summary-value">{{ avgModalTotal | number:'1.1-1' }}d</span><span
            class="avg-summary-label">Total Days</span></div>
        <div class="avg-summary-item highlight"><span class="avg-summary-value">{{ avgModalAvg }}d</span><span
            class="avg-summary-label">Average</span></div>
      </div>
      <div class="avg-formula">{{ avgModalTotal | number:'1.1-1' }} days ÷ {{ avgModalDetails.length }} participants =
        <strong>{{ avgModalAvg }}d avg</strong>
      </div>
      <div class="modal-body">
        <table class="avg-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Participant</th>
              <th>Product</th>
              <th>{{ avgModalType === 'initToStart' ? 'Initiated' : 'Started' }}</th>
              <th>{{ avgModalType === 'initToStart' ? 'Started' : 'Completed' }}</th>
              <th>Days</th>
            </tr>
          </thead>
          <tbody>
            <tr *ngFor="let row of avgModalDetails; let i = index">
              <td>{{ i + 1 }}</td>
              <td>{{ row.name }}</td>
              <td>{{ row.productName }}</td>
              <td>{{ row.fromDate | date:'dd MMM yyyy' }}</td>
              <td>{{ row.toDate | date:'dd MMM yyyy' }}</td>
              <td [ngClass]="{'high-days': row.days > avgModalAvg * 2}">{{ row.days }}d</td>
            </tr>
          </tbody>
        </table>
        <div class="no-data" *ngIf="avgModalDetails.length === 0">No participants have both dates recorded.</div>
      </div>
    </div>
  </div>

  <!-- ========== STAGE MODAL ========== -->
  <div *ngIf="openAppointmentModal" class="modal-overlay">
    <div class="modal-content">
      <div class="diag-modal-header">
        <div class="diag-modal-title">
          <span id="diagModalTitle">{{ this.selectedStage }} {{ this.selectedStageFilter}} Participants</span>
          <span id="diagModalCount" class="diag-modal-count"></span>
        </div>
        <button class="diag-modal-close" (click)="closeStageModal()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
      <!-- Filter Tabs -->
      <div class="diag-tabs">
        <button class="diag-tab" [class.active]="selectedFilter === 'all'" (click)="onFilterChange('all')">
          All
        </button>
        <button class="diag-tab" [class.active]="selectedFilter === 'today'" (click)="onFilterChange('today')">
          Today
        </button>
        <button class="diag-tab" [class.active]="selectedFilter === 'tomorrow'" (click)="onFilterChange('tomorrow')">
          Tomorrow
        </button>
        <button class="diag-tab" [class.active]="selectedFilter === 'overdue'" (click)="onFilterChange('overdue')">
          <span class="diag-tab-dot"></span>
          Missed / Overdue
        </button>
      </div>
      <!-- List -->
      <div class="diag-modal-list" id="diagModalList">
        <div class="profile-row" *ngFor="let app of groupedByStageProfileAll; let i = index">
          <div class="profile-header">
            <span class="participant-index">{{ i + 1 }}</span>
            <a class="participant-name" [href]="'/participantdeliverysequence/' + app.profileid">
              {{ mapMetaData[app.profileid]?.['name'] || app.profileid }}
            </a>
          </div>
          <div class="profile-products">
            <div class="product-tag">
              <span class="status-tag" [ngClass]="selectedStageFilter === 'Scheduled' ? 'scheduled' : 'not-scheduled'">
                {{ selectedStageFilter === 'Scheduled' ? 'Scheduled' : 'Not Scheduled' }}
              </span>
              <span *ngIf="selectedStageFilter === 'Scheduled'">
                <span class="fw-bold">Start: </span>
                <span>{{ app.starttime.toDate() | date:'dd MMM yyyy, hh:mm a' }}</span>
                <span class="fw-bold ps-2">End: </span>
                <span>{{ app.endtime.toDate() | date:'dd MMM yyyy, hh:mm a' }}</span>
              </span>
            </div>
          </div>
        </div>
        <div *ngIf="groupedByStageProfileAll.length === 0" class="no-data">
          No data yet
        </div>
      </div>
    </div>
  </div>

  <!-- ========== STAGES ========== -->
  <div class="flow-section">
    <div class="header">
      <div class="stages-title-block">
        <div class="title">Stages</div>
        <div class="stages-product-tabs">
          <button class="stages-pchip"
            *ngIf="!productFilterActive || (productFilterControl.value || []).includes('EI Starter Pack')"
            [class.active]="selectedProductLabel === 'EI Starter Pack'"
            (click)="selectProduct('EI Starter Pack')">
            <span class="stages-pchip-dot stages-pchip-dot-starter"></span>EI Starter Pack
          </button>
          <button class="stages-pchip"
            *ngIf="!productFilterActive || (productFilterControl.value || []).includes('Critical Support')"
            [class.active]="selectedProductLabel === 'Critical Support'"
            (click)="selectProduct('Critical Support')">
            <span class="stages-pchip-dot stages-pchip-dot-critical"></span>Critical Support
          </button>
        </div>
      </div>
      <div class="header-right">
        <div class="search-container" *ngIf="selectedProductLabel">
          <div class="search-field">
            <mat-icon matSuffix>search</mat-icon>
            <input matInput type="text" placeholder="Search participant..." (input)="searchParticipant($event)"
              [(ngModel)]="searchText" />
          </div>
        </div>

        <div class="stages-limited-chip" *ngIf="!appointmentsAccessible"
             matTooltip="Your role can't read the appointments collection. Stage counts come from participantsproduct and still work; per-appointment detail is hidden.">
          <span class="stages-limited-dot"></span>
          <span class="stages-limited-text">Limited data</span>
        </div>
      </div>
    </div>

    <div class="stages-empty" *ngIf="!selectedProductLabel && !stagesLoading">
      <div class="stages-empty-title">Pick a product to inspect stages</div>
      <div class="stages-empty-hint">Choose EI Starter Pack or Critical Support above to drill into stage-by-stage data.</div>
    </div>

    <!-- Skeleton: kanban placeholder while selectProduct() resolves -->
    <div class="stages-skeleton" *ngIf="stagesLoading" aria-busy="true" aria-live="polite">
      <div class="stages-skel-col" *ngFor="let _ of [0,1,2,3,4,5]">
        <div class="stages-skel-head">
          <div class="stages-skel-line stages-skel-w50"></div>
          <div class="stages-skel-pill"></div>
        </div>
        <div class="stages-skel-card" *ngFor="let __ of [0,1,2]">
          <div class="stages-skel-line stages-skel-w70"></div>
          <div class="stages-skel-line stages-skel-w40"></div>
          <div class="stages-skel-line stages-skel-w60"></div>
        </div>
      </div>
    </div>

    <!-- Flow Stats Cards -->
    <!-- Total Eligible -->
    <div class="d-flex board" *ngIf="selectedProductLabel && !stagesLoading">
      <div id="loading" *ngIf="participantLoading">
        <div class="spinner"></div>
      </div>
      <ng-container *ngIf="!participantLoading">
        <div class="column" *ngFor="let col of selectedColumns; let i = index">
          <div class="col-header" [style.--colColor]="'var(--c' + i + ')'">
            <div class="header-col">
              <div class="d-flex filter-asc" (click)="sortColumn(i)">
                <div class="col-header-left">
                  <span class="col-title">{{ col }}</span>
                </div>
                <div class="filter-asc ps-2">
                  <i class="fas text-black-50 filter-asc" [ngClass]="{'fa-sort': !sortDirection[i], 'fa-sort-up': sortDirection[i] === 'asc', 'fa-sort-down': sortDirection[i] === 'desc'}">
                  </i>
                </div>
              </div>
              <span class="col-badge">
                {{ filteredCardsMap[i]?.length || 0 }}
              </span>
            </div>
            <div>
              <div class="col-mini-stats">
                <ng-container *ngIf="stageData[col.toLowerCase()] as stage">
                  <div (click)="openStageModal(col, 'Scheduled', stage.all)" class="mini-stat mini-stat-clickable"
                    title="View scheduled participants">
                    <div class="mini-stat-val" style="color:var(--blue)">
                      {{ stage.all.length || 0 }}
                    </div>
                    <div class="mini-stat-lbl">Scheduled</div>
                  </div>
                  <!-- Awaiting -->
                  <!-- <div (click)="openStageModal(col, 'Awaiting', stage.awaiting)" class="mini-stat mini-stat-clickable"
                    title="View awaiting participants">
                    <div class="mini-stat-val" style="color:var(--coral)">
                      {{ stage.awaiting?.length || 0 }}
                    </div>
                    <div class="mini-stat-lbl">Awaiting</div>
                  </div> -->
                </ng-container>
              </div>
            </div>
          </div>

          <div class="col-body">
            <ng-container *ngIf="filteredCardsMap[i]?.length > 0; else noData">
              <div class="card" *ngFor="let c of filteredCardsMap[i]; trackBy: trackByCard"
                [class.card-expanded]="c._expanded">

                <!-- Visible Card -->
                <div class="card-top" (click)="c._expanded = !c._expanded" style="cursor:pointer;">
                  <div class="card-info">
                    <div class="card-name">
                      {{ c?.profileid ? mapMetaData[c.profileid]?.name : mapMetaData[c.clientid]?.name }}
                    </div>
                  </div>
                </div>
                <!-- Status -->
                <div class="d-flex">
                  <span class="card-status s-{{c.status || 'default'}} mb-0 pb-0" (click)="toggleExpand(c, i)">
                    {{ c?.profileid ? (c.status || 'NOT INITIATED') : 'Pending' }}
                  </span>
                  <span class="card-status" *ngIf="(c?.status === null || c?.status === 'initiated')">
                    {{
                    addonsPackageLookup[c?.packageref?.id || c?.packageref]
                    || bonusPackageLookup[c?.packageref?.id || c?.packageref]
                    || 'Purchased'
                    }}
                  </span>
                </div>

                <!-- Active Appointment Detail -->
                <div class="detail-row" (click)="toggleExpand(c, i)">
                  <span class="d-flex flex-column">
                    <span>
                      <span class="detail-label">
                        {{ showActiveStage(c) }}
                      </span>
                      <span class="detail-val">
                        {{ showParticipantActiveDate(c) }}
                      </span>
                    </span>
                    <span>
                      <ng-container *ngIf="c?.status === 'ongoing' && c.hosts?.length">
                        <span class="detail-label">Specialist: </span>
                        <span class="detail-val">
                          {{
                          mapMetaData[
                          (c.hosts[0]?.path || c.hosts[0]).split('/').pop()
                          ]?.name
                          }}
                        </span>
                      </ng-container>
                    </span>
                    <span>
                      <ng-container *ngIf="showDelayDate(c) as delay">
                        <span *ngIf="delay" class="detail-label">Delayed By: </span>
                        <span *ngIf="delay" class="detail-val">{{ delay }}</span>
                      </ng-container>
                    </span>
                  </span>
                  <span class="chevron" [class.open]="c._expanded">
                  </span>
                </div>

                <!-- Expandable Section -->
                <div class="expand-section" [class.expanded]="c._expanded" [class.collapsed]="!c._expanded">
                  <hr class="divider">
                  <ng-container>
                    <div *ngFor="let stage of stages">
                      <!-- When appointments exist -->
                      <ng-container *ngIf="getAppointmentsByStage(stage, c?.allappointments) as appointments">
                        <ng-container *ngIf="appointments.length > 0; else noAppointments">
                          <div *ngFor="let appointment of appointments"
                            class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                              <div class="detail-stage-label text-muted">
                                {{ stage }}
                              </div>
                              <div *ngIf="appointment?.starttime">
                                <span class="detail-stage-label">Start: </span>
                                <span class="detail-stage-label">
                                  {{ formatDateTime(appointment?.starttime) }}
                                </span>
                              </div>
                              <div *ngIf="appointment?.endtime">
                                <span class="detail-stage-label">End: </span>
                                <span class="detail-stage-label">
                                  {{ formatDateTime(appointment?.endtime) }}
                                </span>
                              </div>
                              <div *ngIf="appointment?.date">
                                <span class="detail-stage-label">Submitted: </span>
                                <span class="detail-stage-label">
                                  {{ formatDateTime(appointment?.date) }}
                                </span>
                              </div>
                            </div>
                            <div class="status-badge" [ngClass]="getStyleStatusClass(appointment)">
                              {{ getAppointmentStatus(stage, appointment) }}
                            </div>
                          </div>
                        </ng-container>
                        <!-- When NO appointments -->
                        <ng-template #noAppointments>
                          <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                              <div class="detail-stage-label text-muted">
                                {{ stage }}
                              </div>
                            </div>
                            <div class="status-badge status-notscheduled">
                              Not Scheduled
                            </div>
                          </div>
                        </ng-template>
                      </ng-container>
                    </div>
                  </ng-container>
                </div>
              </div>
            </ng-container>
            <ng-template #noData>
              <div class="no-data-card">
                No Data Yet
              </div>
            </ng-template>
          </div>
        </div>
      </ng-container>

      <!-- Flow Table -->
      <div class="flow-table-container" *ngIf="showTable">
        <table class="flow-search-participant-table">
          <thead>
            <tr>
              <th *ngFor="let header of searchedParticipantHeaders">
                {{ header }}
              </th>
            </tr>
          </thead>
          <tbody>
            <tr *ngFor="let row of filteredData">
              <td>{{ row.name }}</td>
              <td>{{ row.email }}</td>
              <td>{{ row.initiated }}</td>
              <td>{{ row.welcomeCall }}</td>
              <td>{{ row.clarityCall }}</td>
              <td>{{ row.diagnostics }}</td>
              <td>{{ row.implementation }}</td>
              <td>{{ row.midReviewDiagnostics }}</td>
              <td>{{ row.implementationPhase2 }}</td>
              <td>{{ row.finalReview }}</td>
              <td>{{ row.completed }}</td>
              <td>{{ row.needsValidation }}</td>
            </tr>
            <tr *ngIf="filteredData.length === 0">
              <td colspan="12" style="text-align:center;">
                No participant found
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ========== SPECIALIST APPOINTMENT SLOTS ========== -->
  <div class="specialist-section-container" [class.specialist-collapsed]="specialistCollapsed">
    <div class="specialist-section-header-row">
      <div class="specialist-section-title-wrap">
        <h2 class="specialist-section-title">Specialist Appointment Slots</h2>
        <span class="specialist-section-summary" *ngIf="specialistCollapsed && !specialistLoading">
          <span class="ss-pill"><strong>{{ slotOverview.totalSlots }}</strong> total</span>
          <span class="ss-pill"><strong>{{ slotOverview.booked }}</strong> booked</span>
          <span class="ss-pill"><strong>{{ slotOverview.available }}</strong> available</span>
          <span class="ss-pill ss-pill-rate"><strong>{{ slotOverview.bookingRate }}%</strong> booking rate</span>
        </span>
      </div>
      <div class="specialist-header-controls">
        <div class="date-input" *ngIf="!specialistCollapsed" (click)="specialistPicker.open()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
          Date Range
          <mat-form-field appearance="outline" class="date-range-field-hidden">
            <mat-date-range-input [formGroup]="specialistRange" [rangePicker]="specialistPicker">
              <input matStartDate formControlName="start" placeholder="Start date">
              <input matEndDate formControlName="end" placeholder="End date">
            </mat-date-range-input>
            <mat-date-range-picker #specialistPicker></mat-date-range-picker>
          </mat-form-field>
        </div>
        <button class="specialist-collapse-btn" (click)="specialistCollapsed = !specialistCollapsed">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline *ngIf="specialistCollapsed" points="6 9 12 15 18 9" />
            <polyline *ngIf="!specialistCollapsed" points="18 15 12 9 6 15" />
          </svg>
          {{ specialistCollapsed ? 'Expand' : 'Collapse' }}
        </button>
      </div>
    </div>

    <!-- Loading -->
    <div class="specialist-loading" *ngIf="specialistLoading && !specialistCollapsed">
      <div class="specialist-loading-spinner"></div>
      <span class="specialist-loading-text">Loading appointment slots...</span>
    </div>

    <!-- Content -->
    <ng-container *ngIf="!specialistLoading && !specialistCollapsed">
      <div class="specialist-layout">
        <!-- Left: Summary Card -->
        <div class="specialist-summary">
          <h3 class="ss-title">📋 Slot Overview</h3>
          <p class="ss-subtitle">Aggregate across all specialists for selected range</p>
          <div class="slot-stats">
            <div class="slot-stat total">
              <div class="slot-number">{{ slotOverview.totalSlots }}</div>
              <div class="slot-label">Total Slots</div>
            </div>
            <div class="slot-stat booked">
              <div class="slot-number">{{ slotOverview.booked }}</div>
              <div class="slot-label">Booked</div>
            </div>
            <div class="slot-stat available">
              <div class="slot-number">{{ slotOverview.available }}</div>
              <div class="slot-label">Available</div>
            </div>
          </div>
          <div class="booking-rate-wrap">
            <div class="booking-rate-label"><span>Booking Rate</span><span class="booking-rate-pct">{{
                slotOverview.bookingRate }}%</span></div>
            <div class="booking-bar">
              <div class="booking-fill" [style.width.%]="slotOverview.bookingRate"></div>
            </div>
            <div class="booking-rate-footer">
              <span class="booking-rate-hint">{{ slotOverview.available }} slots still open for booking</span>
            </div>
          </div>
          <div class="by-product-section">
            <div class="by-product-title">BY PRODUCT</div>
            <div class="by-product-list">
              <div class="by-product-row" *ngFor="let bp of slotsByProduct">
                <span class="by-product-name">{{ bp.name }}</span>
                <div class="by-product-bar-wrap">
                  <div class="by-product-bar">
                    <div class="by-product-bar-fill" [style.width.%]="bp.pct" [style.background]="bp.color"></div>
                  </div>
                  <span class="by-product-count" [style.color]="bp.color">{{ bp.booked }} / {{ bp.total }}</span>
                </div>
              </div>
              <div *ngIf="slotsByProduct.length === 0" class="no-data-text">No product data available</div>
            </div>
          </div>
        </div>

        <!-- Right: Specialist Table -->
        <div class="specialist-table-wrap">
          <div class="specialist-table-header">
            <h3>Specialist Appointment Details</h3>
            <div class="month-badge">📅 {{ specialistDisplayMonth }}</div>
          </div>
          <div class="specialist-table-scroll">
            <table class="specialist-table">
              <thead>
                <tr>
                  <th>Specialist</th>
                  <th>DFU Product</th>
                  <th>Total Slots</th>
                  <th>Booked</th>
                  <th>Available</th>
                  <th>Slot Utilization</th>
                </tr>
              </thead>
              <tbody>
                <tr *ngFor="let specialist of specialistData">
                  <td>
                    <div class="specialist-name">{{ specialist.name }}</div>
                    <div class="specialist-role">{{ specialist.role }}</div>
                  </td>
                  <td><span class="sp-product-tag" [ngClass]="specialist.productClass">{{ specialist.product
                      }}</span>
                  </td>
                  <td class="fw-600">{{ specialist.appointmentsGiven }}</td>
                  <td><span class="blue-bold">{{ specialist.booked }}</span></td>
                  <td><span class="green-bold">{{ specialist.availableSlots }}</span></td>
                  <td>
                    <div class="slots-visual">
                      <div class="slot-dot" *ngFor="let dot of specialist.slotDots"
                        [ngClass]="{'booked': dot === 'booked', 'open': dot === 'open'}"></div>
                    </div>
                    <div class="slots-text"><strong>{{ specialist.utilizationPct }}%</strong> utilized<span
                        *ngIf="specialist.utilizationNote" [style.color]="specialist.utilizationNoteColor"
                        class="util-note"> · {{ specialist.utilizationNote }}</span></div>
                  </td>
                </tr>
                <tr *ngIf="specialistData.length === 0">
                  <td colspan="6" class="pm-no-data">No specialist data available for the selected range</td>
                </tr>
                <tr class="total-row" *ngIf="specialistData.length > 0">
                  <td colspan="2" class="total-label">TOTAL</td>
                  <td class="total-value">{{ slotOverview.totalSlots }}</td>
                  <td class="total-value blue-bold">{{ slotOverview.booked }}</td>
                  <td class="total-value green-bold">{{ slotOverview.available }}</td>
                  <td class="total-util">{{ slotOverview.bookingRate }}% avg. utilization</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </ng-container>
  </div>

    <!-- ========== COMPLETION HISTORY BY DFU PRODUCT ========== -->
    <div class="completion-history-container">
      <div class="ch-header">
        <h2 class="ch-title">Completion History by DFU Product</h2>
      </div>

      <!-- Summary Bar (always visible) -->
      <div class="ch-summary-bar">
        <div class="ch-summary-item">
          <div class="ch-sum-num">{{ getCompletionSummary().totalCompleted }}</div>
          <div class="ch-sum-lbl">Total Completed</div>
        </div>
        <div class="ch-summary-sep"></div>
        <div class="ch-summary-item">
          <div class="ch-sum-num green">{{ getCompletionSummary().avgStartToDone }}d</div>
          <div class="ch-sum-lbl">Avg. Days (Start→Done)</div>
        </div>
        <div class="ch-summary-sep"></div>
        <div class="ch-summary-item">
          <div class="ch-sum-num blue">{{ getCompletionSummary().avgInitToStart }}d</div>
          <div class="ch-sum-lbl">Avg. Days (Init→Start)</div>
        </div>
        <div class="ch-summary-sep"></div>
        <div class="ch-summary-item">
          <div class="ch-sum-num purple">{{ getCompletionSummary().productsActive }}</div>
          <div class="ch-sum-lbl">Products Active</div>
        </div>
      </div>

      <!-- VISIBLE Product Cards (always shown) -->
      <div class="ch-product-grid">
        <div class="ch-product-card" *ngFor="let product of getCompletionProductsVisible()"
          [style.--pc]="product.color">
          <div class="ch-pc-head">
            <span class="ch-pc-icon" [style.background]="product.iconBg" [style.color]="product.color"
              aria-hidden="true">{{ productMonogram(product.name) }}</span>
            <div>
              <div class="ch-pc-name">{{ product.name }}</div>
              <div class="ch-pc-sub" *ngIf="product.subName">{{ product.subName }}</div>
            </div>
          </div>
          <div class="ch-pc-big" [style.color]="product.color">{{ product.completed }}</div>
          <div class="ch-pc-big-lbl">Completed</div>
          <div class="ch-pc-stats">
            <div class="ch-pc-stat"><span>Bonus completions</span><strong>{{ product.bonusCompletions }}</strong>
            </div>
            <div class="ch-pc-stat"><span>Purchased completions</span><strong>{{ product.purchasedCompletions
                }}</strong>
            </div>
            <div class="ch-pc-stat"><span>Active sub users</span><strong>{{ product.activeSubUsers }}</strong></div>
            <div class="ch-pc-stat"><span>Non-active sub users</span><strong>{{ product.noSubUsers }}</strong></div>
            <div class="ch-pc-stat ch-pc-stat-time"><span>⏱ Init→Start</span><strong [style.color]="product.color">{{
                product.avgInitToStart }}d</strong></div>
            <div class="ch-pc-stat ch-pc-stat-time"><span>⏱ Start→Done</span><strong class="green-text">{{
                product.avgStartToDone }}d</strong></div>
          </div>
        </div>
      </div>

      <!-- Toggle for HIDDEN Product Cards -->
      <div class="show-more-row" *ngIf="getCompletionProductsHidden().length > 0">
        <button class="show-more-btn" (click)="showHiddenCompletionProducts = !showHiddenCompletionProducts">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline *ngIf="!showHiddenCompletionProducts" points="6 9 12 15 18 9" />
            <polyline *ngIf="showHiddenCompletionProducts" points="18 15 12 9 6 15" />
          </svg>
          {{ showHiddenCompletionProducts ? 'Hide' : 'Show' }} {{ getCompletionProductsHidden().length }} Hidden
          Products
        </button>
      </div>

      <!-- HIDDEN Product Cards (toggle) -->
      <div class="ch-product-grid ch-hidden-cards" *ngIf="showHiddenCompletionProducts">
        <div class="ch-product-card ch-hidden-card" *ngFor="let product of getCompletionProductsHidden()"
          [style.--pc]="product.color">
          <div class="ch-pc-head">
            <span class="ch-pc-icon" [style.background]="product.iconBg" [style.color]="product.color"
              aria-hidden="true">{{ productMonogram(product.name) }}</span>
            <div>
              <div class="ch-pc-name">{{ product.name }}</div>
              <div class="ch-pc-sub" *ngIf="product.subName">{{ product.subName }}</div>
            </div>
            <span class="hidden-tag" style="margin-left: auto;">Hidden</span>
          </div>
          <div class="ch-pc-big" [style.color]="product.color">{{ product.completed }}</div>
          <div class="ch-pc-big-lbl">Completed</div>
          <div class="ch-pc-stats">
            <div class="ch-pc-stat"><span>Bonus completions</span><strong>{{ product.bonusCompletions }}</strong>
            </div>
            <div class="ch-pc-stat"><span>Purchased completions</span><strong>{{ product.purchasedCompletions
                }}</strong>
            </div>
            <div class="ch-pc-stat"><span>Active sub users</span><strong>{{ product.activeSubUsers }}</strong></div>
            <div class="ch-pc-stat"><span>Non-active sub users</span><strong>{{ product.noSubUsers }}</strong></div>
            <div class="ch-pc-stat ch-pc-stat-time"><span>⏱ Init→Start</span><strong [style.color]="product.color">{{
                product.avgInitToStart }}d</strong></div>
            <div class="ch-pc-stat ch-pc-stat-time"><span>⏱ Start→Done</span><strong class="green-text">{{
                product.avgStartToDone }}d</strong></div>
          </div>
        </div>
      </div>
    </div>

  
      </ng-template>
    </mat-tab>

    <mat-tab label="Analytics">
      <ng-template matTabContent>
        <!-- ========== ANALYTICS TAB ========== -->
        <div class="analytics-tab">

          <div class="analytics-loading" *ngIf="analyticsLoading">
            <div class="skeleton analytics-skeleton-block"></div>
            <div class="skeleton analytics-skeleton-block"></div>
            <div class="skeleton analytics-skeleton-block"></div>
          </div>

          <div class="analytics-error" *ngIf="analyticsError && !analyticsLoading">
            <div class="analytics-error-title">Couldn't load analytics</div>
            <div class="analytics-error-hint">{{ analyticsError }}</div>
            <button class="analytics-retry" (click)="analyticsLoaded = false; loadAnalytics()">Retry</button>
          </div>

          <ng-container *ngIf="!analyticsLoading && !analyticsError && analyticsLoaded">

            <!-- 1. Completion velocity (line) -->
            <section class="analytics-section">
              <header class="analytics-section-head">
                <div>
                  <h2 class="analytics-section-title">Completion velocity</h2>
                  <p class="analytics-section-sub">Weekly completions per product · last 12 weeks</p>
                </div>
              </header>

              <ng-container *ngIf="velocityChart.weeks.length > 0; else velocityEmpty">
                <div class="analytics-chart-wrap">
                  <svg class="velocity-svg"
                       [attr.viewBox]="'0 0 ' + velocityChart.width + ' ' + velocityChart.height"
                       preserveAspectRatio="xMidYMid meet">

                    <g class="vc-axis">
                      <line [attr.x1]="velocityChart.pad.l"
                            [attr.y1]="velocityChart.height - velocityChart.pad.b"
                            [attr.x2]="velocityChart.width - velocityChart.pad.r"
                            [attr.y2]="velocityChart.height - velocityChart.pad.b" />
                      <line [attr.x1]="velocityChart.pad.l"
                            [attr.y1]="velocityChart.pad.t"
                            [attr.x2]="velocityChart.pad.l"
                            [attr.y2]="velocityChart.height - velocityChart.pad.b" />
                    </g>

                    <g class="vc-ylabel">
                      <text [attr.x]="velocityChart.pad.l - 8" [attr.y]="velocityChart.pad.t + 4" text-anchor="end">{{ velocityChart.yMax }}</text>
                      <text [attr.x]="velocityChart.pad.l - 8" [attr.y]="velocityChart.height - velocityChart.pad.b + 4" text-anchor="end">0</text>
                    </g>

                    <g class="vc-xlabel">
                      <text *ngFor="let w of velocityChart.weeks; let i = index"
                            [attr.x]="velocityChart.pad.l + i * ((velocityChart.width - velocityChart.pad.l - velocityChart.pad.r) / (velocityChart.weeks.length - 1 || 1))"
                            [attr.y]="velocityChart.height - velocityChart.pad.b + 16"
                            text-anchor="middle">{{ velocityWeekLabel(w) }}</text>
                    </g>

                    <g class="vc-lines">
                      <ng-container *ngFor="let line of velocityChart.lines">
                        <path [attr.d]="line.pathD" [attr.stroke]="line.color" class="vc-line-path" fill="none" />
                        <circle *ngFor="let p of line.points"
                                [attr.cx]="p.x" [attr.cy]="p.y" r="3.5"
                                [attr.fill]="line.color" class="vc-line-dot">
                          <title>{{ line.product }}: {{ p.count }} completions</title>
                        </circle>
                      </ng-container>
                    </g>
                  </svg>

                  <div class="vc-legend">
                    <span class="vc-legend-item" *ngFor="let line of velocityChart.lines">
                      <span class="vc-legend-swatch" [style.background]="line.color"></span>
                      {{ line.product }}
                    </span>
                  </div>
                </div>
              </ng-container>
              <ng-template #velocityEmpty>
                <div class="analytics-empty">No completions in the last 12 weeks for the selected products.</div>
              </ng-template>
            </section>

            <!-- 2. Funnel drop-off -->
            <section class="analytics-section">
              <header class="analytics-section-head">
                <div>
                  <h2 class="analytics-section-title">Funnel drop-off</h2>
                  <p class="analytics-section-sub">Stage retention per product (% of initiated cohort)</p>
                </div>
              </header>

              <div class="funnel-grid-products" *ngIf="funnelChart.products.length > 0; else funnelEmpty">
                <article class="funnel-product" *ngFor="let p of funnelChart.products">
                  <div class="funnel-product-head">
                    <span class="funnel-product-name">{{ p.product }}</span>
                    <span class="funnel-product-total">{{ p.total | number }} <span>initiated</span></span>
                  </div>
                  <div class="funnel-rows">
                    <div class="funnel-row" *ngFor="let s of p.stages">
                      <span class="funnel-row-label">{{ s.stage }}</span>
                      <div class="funnel-row-bar">
                        <div class="funnel-row-fill" [style.width.%]="s.pct"></div>
                      </div>
                      <span class="funnel-row-num">{{ s.count | number }}</span>
                      <span class="funnel-row-pct">{{ s.pct }}%</span>
                    </div>
                  </div>
                </article>
              </div>
              <ng-template #funnelEmpty>
                <div class="analytics-empty">No funnel data for the selected products.</div>
              </ng-template>
            </section>

            <!-- 3. Specialist utilization -->
            <section class="analytics-section">
              <header class="analytics-section-head">
                <div>
                  <h2 class="analytics-section-title">Specialist utilization</h2>
                  <p class="analytics-section-sub">Booked vs. open slots per week, last 8 weeks · sorted by avg utilization</p>
                </div>
              </header>

              <div class="util-table" *ngIf="utilizationChart.specialists.length > 0; else utilEmpty">
                <div class="util-row util-row-head">
                  <span class="util-name">Specialist</span>
                  <div class="util-cells">
                    <span class="util-cell util-cell-head" *ngFor="let w of utilizationChart.specialists[0].weeks">{{ velocityWeekLabel(w.week) }}</span>
                  </div>
                  <span class="util-avg">Avg</span>
                </div>
                <div class="util-row" *ngFor="let s of utilizationChart.specialists">
                  <span class="util-name">{{ s.profile_ref }}</span>
                  <div class="util-cells">
                    <span class="util-cell" *ngFor="let w of s.weeks"
                          [class]="'util-tone-' + utilTone(w.util)"
                          [matTooltip]="w.booked + ' booked · ' + w.available + ' open · ' + ((w.util * 100) | number:'1.0-0') + '%'">
                      {{ (w.util * 100) | number:'1.0-0' }}
                    </span>
                  </div>
                  <span class="util-avg">{{ (s.avgUtil * 100) | number:'1.0-0' }}%</span>
                </div>
              </div>
              <ng-template #utilEmpty>
                <div class="analytics-empty">No specialist activity in the last 8 weeks.</div>
              </ng-template>
            </section>

          </ng-container>
        </div>
      </ng-template>
    </mat-tab>

    <mat-tab label="Participants">
      <ng-template matTabContent>
    <!-- ========== PARTICIPANT MANAGEMENT (NEW DESIGN) ========== -->
    <div class="pm-section">
      <div class="pm-header">
        <h2 class="pm-title">Participant Management & Actions</h2>
        <div class="pm-actions">
          <form [formGroup]="filterForm" class="pm-search-and-filters">
            <div class="pm-search-wrap">
              <span class="pm-search-icon">🔍</span>
              <input type="text" class="pm-search-input" placeholder="Search by name..." formControlName="search"
                (input)="filterTableData()" />
              <button *ngIf="filterForm.value.search" (click)="clearSearch()" class="pm-clear-search"
                title="Clear search">✕</button>
            </div>
            <mat-form-field appearance="outline" class="pm-filter-field">
              <mat-label>Journey</mat-label>
              <mat-select placeholder="Select Journey" formControlName="journey" (selectionChange)="filterTableData()"
                multiple>
                <mat-option *ngFor="let journey of getUniqueJourneysForCurrentTab()" [value]="journey">{{
                  journey}}</mat-option>
              </mat-select>
            </mat-form-field>
            <mat-form-field appearance="outline" class="pm-filter-field"
              *ngIf="currentTabIndex === 2 || activeFilter === 'todayActivity' || activeFilter === 'last7DaysActivity' || activeFilter === 'last30DaysActivity' || activeFilter === 'thisMonthActivity'">
              <mat-label>Product</mat-label>
              <mat-select placeholder="Select Product" formControlName="product" (selectionChange)="filterTableData()"
                multiple>
                <mat-option *ngFor="let product of getUniqueProductsForCurrentTab()" [value]="product">{{ product
                  }}</mat-option>
              </mat-select>
            </mat-form-field>
          </form>
          <button class="pm-btn-primary" (click)="exportTableData()">
            Export &middot; <span class="pm-btn-filter">{{ participantsActiveTabName }}</span>
          </button>
          <button class="pm-btn-primary pm-btn-bulk" (click)="bulkInitiateReady()"
            [disabled]="kpiReadyToInitiate === 0">
            Bulk Initiate Ready <span class="pm-btn-count" *ngIf="kpiReadyToInitiate > 0">({{ kpiReadyToInitiate }})</span>
          </button>
        </div>
      </div>

      <mat-tab-group class="pm-tab-group" (selectedTabChange)="onTabChange($event)" #tabGroup
        [(selectedIndex)]="currentTabIndex">
        <mat-tab>
          <ng-template mat-tab-label><span class="pm-tab-text">Awaiting Initiation</span><span class="pm-tab-count">{{
              originalData['awaitingInitiation'].count }}</span></ng-template>
          <div *ngIf="isFilterActive()" class="pm-filter-indicator">
            <span class="pm-filter-text"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
                style="margin-right:8px">
                <path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" />
              </svg>{{ getFilterDisplayText() }}<span class="pm-filter-count" *ngIf="getActiveFilterCount()"> ({{
                getActiveFilterCount() }})</span></span>
            <button class="pm-clear-filter-btn" (click)="clearActiveFilter()">✕ Clear Filter</button>
          </div>
          <div class="pm-table-container">
            <table class="pm-data-table">
              <thead>
                <tr>
                  <th *ngFor="let header of getCurrentTabHeaders()" [class.checkbox-col]="header.key === 'checkbox'"
                    [style.width]="header.width"><input *ngIf="header.key === 'checkbox'" type="checkbox"
                      class="pm-table-checkbox"><span *ngIf="header.key !== 'checkbox'">{{ header.label }}</span>
                  </th>
                </tr>
              </thead><ng-container *ngTemplateOutlet="pmTableBody"></ng-container>
            </table>
          </div>
        </mat-tab>
        <mat-tab>
          <ng-template mat-tab-label><span class="pm-tab-text">Initiated – Not Consuming</span><span
              class="pm-tab-count">{{ originalData['currentJourneyInitiated'].count }}</span></ng-template>
          <div *ngIf="isFilterActive()" class="pm-filter-indicator">
            <span class="pm-filter-text"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
                style="margin-right:8px">
                <path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" />
              </svg>{{ getFilterDisplayText() }}<span class="pm-filter-count" *ngIf="getActiveFilterCount()"> ({{
                getActiveFilterCount() }})</span></span>
            <button class="pm-clear-filter-btn" (click)="clearActiveFilter()">✕ Clear Filter</button>
          </div>
          <div class="pm-table-container">
            <table class="pm-data-table">
              <thead>
                <tr>
                  <th *ngFor="let header of getCurrentTabHeaders()" [class.checkbox-col]="header.key === 'checkbox'"
                    [style.width]="header.width"><input *ngIf="header.key === 'checkbox'" type="checkbox"
                      class="pm-table-checkbox"><span *ngIf="header.key !== 'checkbox'">{{ header.label }}</span>
                  </th>
                </tr>
              </thead><ng-container *ngTemplateOutlet="pmTableBody"></ng-container>
            </table>
          </div>
        </mat-tab>
        <mat-tab>
          <ng-template mat-tab-label><span class="pm-tab-text">Stuck Cases</span><span class="pm-tab-count">{{
              originalData['stuckCases'].count }}</span></ng-template>
          <div *ngIf="isFilterActive()" class="pm-filter-indicator">
            <span class="pm-filter-text"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
                style="margin-right:8px">
                <path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" />
              </svg>{{ getFilterDisplayText() }}<span class="pm-filter-count" *ngIf="getActiveFilterCount()"> ({{
                getActiveFilterCount() }})</span></span>
            <button class="pm-clear-filter-btn" (click)="clearActiveFilter()">✕ Clear Filter</button>
          </div>
          <div class="pm-table-container">
            <table class="pm-data-table">
              <thead>
                <tr>
                  <th *ngFor="let header of getCurrentTabHeaders()" [class.checkbox-col]="header.key === 'checkbox'"
                    [style.width]="header.width"><input *ngIf="header.key === 'checkbox'" type="checkbox"
                      class="pm-table-checkbox"><span *ngIf="header.key !== 'checkbox'">{{ header.label }}</span>
                  </th>
                </tr>
              </thead><ng-container *ngTemplateOutlet="pmTableBody"></ng-container>
            </table>
          </div>
        </mat-tab>
      </mat-tab-group>

      <ng-template #pmTableBody>
        <tbody>
          <tr *ngFor="let participant of paginatedData" class="pm-table-row"
            [ngClass]="{'urgent-row': getWaitingPeriod(participant) >= 14, 'high-row': getWaitingPeriod(participant) >= 10 && getWaitingPeriod(participant) < 14}">
            <td *ngFor="let header of getCurrentTabHeaders()">
              <input *ngIf="header.key === 'checkbox'" type="checkbox" class="pm-table-checkbox">
              <span *ngIf="header.key === 'priority'" class="pm-priority-badge"
                [ngClass]="{'p-urgent': getWaitingPeriod(participant) >= 14, 'p-high': getWaitingPeriod(participant) >= 10 && getWaitingPeriod(participant) < 14, 'p-medium': getWaitingPeriod(participant) >= 5 && getWaitingPeriod(participant) < 10, 'p-low': getWaitingPeriod(participant) < 5}">{{
                getPriorityLabel(getWaitingPeriod(participant)) }}</span>
              <span *ngIf="header.type === 'mapped' && header.key !== 'checkbox' && header.key !== 'priority'"
                [ngClass]="{'pm-participant-name': header.mapValue === 'name'}">{{
                mapMetaData[participant[header.key]]?.[header.mapValue] || 'N/A' }}</span>
              <span *ngIf="header.type === 'date' && header.key !== 'checkbox'" class="pm-date-text">{{
                participant[header.key]?.toDate ? (participant[header.key].toDate() | date: header.format) :
                (participant[header.key] | date: header.format) }}</span>
              <span
                *ngIf="header.type === 'text' && header.key !== 'checkbox' && header.key !== 'priority' && header.key !== 'addnotes' && header.key !== 'waitingperiod'">{{
                participant[header.key] || 'N/A' }}</span>
              <span *ngIf="header.key === 'waitingperiod'" class="pm-days-badge"
                [ngClass]="{'days-red': participant[header.key] >= 14, 'days-amber': participant[header.key] >= 7 && participant[header.key] < 14, 'days-green': participant[header.key] < 7}">{{
                participant[header.key] }} DAYS</span>
              <span *ngIf="header.key === 'addnotes'">
                <div (click)="addNotes(participant)"><mat-icon class="pm-edit-icon">edit_note</mat-icon></div>
              </span>
              <span *ngIf="header.key === 'generalnotes'" #notesContainer
                (mouseenter)="showPopup(participant, $event, notesContainer)" (mouseleave)="hidePopupWithDelay()">
                <div class="pm-notes-container">
                  <div *ngIf="participant['generalnotes']?.length > 0"><span
                      (click)="viewNotes(participant, header.key)" class="pm-note-text"
                      matTooltip="{{ participant['generalnotes'][participant['generalnotes'].length - 1].note }}">{{
                      participant['generalnotes'][participant['generalnotes'].length - 1].note | slice:0:20
                      }}...</span>
                  </div>
                </div>
              </span>
              <span *ngIf="header.key === 'financialdata'" class="pm-status-pill"
                [ngClass]="{'s-eligible': participant[header.key] === 'Cleared', 's-Not Scheduled': participant[header.key] === 'Not Scheduled'}">{{
                participant[header.key] === 'Cleared' ? 'ELIGIBLE' : 'NOT CLEARED' }}</span>
              <span *ngIf="header.key === 'bottleneck'" class="pm-bottleneck-text">{{ participant['financialdata']
                ===
                'Cleared' ? 'Ready for Initiation' : 'Payment Follow-up' }}</span>
              <button *ngIf="header.key === 'action'" class="pm-initiate-btn"
                (click)="openParticipantPurchase(participant)">INITIATE NOW</button>
            </td>
          </tr>
          <tr *ngIf="getCurrentTabData().length === 0">
            <td [attr.colspan]="getCurrentTabHeaders().length" class="pm-no-data">No participants found</td>
          </tr>
        </tbody>
      </ng-template>
    </div>

    <!-- Pagination Footer -->
    <div class="pm-table-footer">
      <div class="pm-row-info">Showing {{ (currentPage - 1) * itemsPerPage + 1 }} to {{ Math.min(currentPage *
        itemsPerPage, getCurrentTabData().length) }} of {{ getCurrentTabData().length }} entries</div>
      <div class="pm-pagination">
        <button class="pm-page-btn" (click)="firstPage()" [disabled]="currentPage === 1" title="First Page"><svg
            width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.41 16.59L13.82 12l4.59-4.59L17 6l-6 6 6 6zM6 6h2v12H6z" />
          </svg></button>
        <button class="pm-page-btn" (click)="previousPage()" [disabled]="currentPage === 1">Previous</button>
        <div class="pm-page-numbers"><button *ngFor="let page of getPageNumbers()" class="pm-page-number"
            [class.active]="page === currentPage" (click)="goToPage(page)">{{ page }}</button></div>
        <button class="pm-page-btn" (click)="nextPage()" [disabled]="currentPage === totalPages">Next</button>
        <button class="pm-page-btn" (click)="lastPage()" [disabled]="currentPage === totalPages" title="Last Page"><svg
            width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5.59 7.41L10.18 12l-4.59 4.59L7 18l6-6-6-6zM16 6h2v12h-2z" />
          </svg></button>
      </div>
      <div class="pm-items-per-page"><label>Show:</label><select [(ngModel)]="itemsPerPage"
          (change)="changeItemsPerPage(itemsPerPage)">
          <option *ngFor="let option of itemsPerPageOptions" [value]="option">{{ option }}</option>
        </select><span>entries</span></div>
    </div>


      </ng-template>
    </mat-tab>
  </mat-tab-group>
</div>